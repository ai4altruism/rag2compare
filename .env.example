# LLM Provider (via LiteLLM)
# Answer-generation model. Defaults to Claude Opus 4.7 for the experiment;
# also supports gpt-4.1, ollama/llama3, etc. via LiteLLM.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=

# Separate model for ingestion-time contextual enrichment. Defaults to a
# cheaper Sonnet so the per-chunk summarization pass doesn't pay Opus rates.
# Set blank to reuse LLM_MODEL for enrichment as well.
ENRICHMENT_LLM_MODEL=claude-sonnet-4-5-20250929

# Anthropic extended-thinking effort: off | low | medium | high | xhigh.
# xhigh = 32K thinking tokens (matches Claude Code's xhigh preset). When
# non-"off", answer generation forces temperature=1.0 (Anthropic requirement).
REASONING_EFFORT=xhigh

# OpenAI (for embeddings)
OPENAI_API_KEY=

# Cohere (for reranking)
COHERE_API_KEY=

# Embedding configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# Reranker configuration
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v3.5

# Qdrant
QDRANT_URL=http://localhost:6333

# Logging
LOG_LEVEL=INFO
